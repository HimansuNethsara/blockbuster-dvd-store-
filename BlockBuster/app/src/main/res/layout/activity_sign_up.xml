<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.SignUpActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_sign"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="580dp"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@color/transparent_layout"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        tools:ignore="TextSizeCheck">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_logo_full_light_desc"
            android:src="@drawable/logo_full_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/signup_title"
            android:textColor="@color/app_primary_fixed"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/first_name"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/signup_input_firstname"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:autofillHints="firstname"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/first_name"
                            android:inputType="textPersonName"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="13sp"
                            tools:ignore="DuplicateSpeakableTextCheck,TextContrastCheck,TouchTargetSizeCheck,VisualLintTextFieldSize" />
                    </LinearLayout>

                    <View
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/last_name"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp"
                            tools:ignore="TextContrastCheck" />

                        <EditText
                            android:id="@+id/signup_input_lastname"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:autofillHints="lastname"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/last_name"
                            android:inputType="textPersonName"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="13sp"
                            tools:ignore="DuplicateSpeakableTextCheck,TextContrastCheck,VisualLintTextFieldSize" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/email_title"
                    android:textColor="@color/app_primary_fixed"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/signup_input_email"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/custom_input_search"
                    android:hint="@string/sample_email_text"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/password_title"
                    android:textColor="@color/app_primary_fixed"
                    android:textSize="12sp"
                    tools:ignore="TextContrastCheck" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:endIconMode="password_toggle"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signup_input_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/custom_input_search"
                        android:hint="@string/sample_password_hint"
                        android:inputType="textPassword"
                        android:minHeight="44dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/retype_password"
                    android:textColor="@color/app_primary_fixed"
                    android:textSize="12sp"
                    tools:ignore="TextContrastCheck" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:endIconMode="password_toggle"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signup_input_retype_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/custom_input_search"
                        android:hint="@string/sample_password_retype_hint"
                        android:inputType="textPassword"
                        android:minHeight="44dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/signup_benefit_title_text"
                    android:textColor="@color/app_primary_fixed"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="6dp"
                        android:text="@string/signup_benefit_text_line1"
                        android:textColor="@color/text_secondary_fixed"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/check_circle_20px" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="6dp"
                        android:text="@string/signup_benefits_text_line5"
                        android:textColor="@color/text_secondary_fixed"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/check_circle_20px" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="6dp"
                        android:text="@string/signup_benefit_text_line2"
                        android:textColor="@color/text_secondary_fixed"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/check_circle_20px" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="6dp"
                        android:text="@string/signup_benefit_text_line3"
                        android:textColor="@color/text_secondary_fixed"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/check_circle_20px" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="6dp"
                        android:text="@string/signup_benefit_text_line4"
                        android:textColor="@color/text_secondary_fixed"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/check_circle_20px" />

                </LinearLayout>

                <TextView
                    android:id="@+id/signup_policy_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_tertiary_fixed"
                    android:textSize="11sp" />

            </LinearLayout>

        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signup_btn_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/create_account"
            app:cornerRadius="10dp"
            tools:ignore="VisualLintButtonSize" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_have_account"
                android:textColor="@color/text_secondary_fixed"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/signup_link_signin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/text_sign_in"
                android:textColor="@color/app_primary_fixed"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="TextContrastCheck,TouchTargetSizeCheck" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>