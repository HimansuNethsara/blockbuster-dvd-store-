<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/transparent_layout">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/privacy_policy_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/app_primary_fixed" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Intro -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_text_main"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_fixed"
                android:lineSpacingExtra="3dp" />

            <!-- Section title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_subtitle1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/app_primary_fixed"
                android:layout_marginTop="12dp"/>

            <!-- Bullet items -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_subtitle1_line1"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_fixed"
                android:drawablePadding="8dp"
                android:layout_marginTop="6dp"
                app:drawableStartCompat="@drawable/bullet_circle_20px"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_subtitle1_line2"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_fixed"
                android:drawablePadding="8dp"
                android:layout_marginTop="4dp"
                app:drawableStartCompat="@drawable/bullet_circle_20px"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_subtitle1_line3"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_fixed"
                android:drawablePadding="8dp"
                android:layout_marginTop="4dp"
                app:drawableStartCompat="@drawable/bullet_circle_20px"/>

            <!-- Section title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_subtitle2"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/app_primary_fixed"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_subtitle2_line1"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_fixed"
                android:drawablePadding="8dp"
                android:layout_marginTop="6dp"
                app:drawableStartCompat="@drawable/bullet_circle_20px"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_subtitle2_line2"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_fixed"
                android:drawablePadding="8dp"
                android:layout_marginTop="4dp"
                app:drawableStartCompat="@drawable/bullet_circle_20px"/>

            <!-- Closing -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_text_close"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_fixed"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Close button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_privacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close_text"
        android:layout_marginTop="14dp"/>

</LinearLayout>