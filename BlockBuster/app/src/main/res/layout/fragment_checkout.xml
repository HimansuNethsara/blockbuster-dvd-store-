<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.CheckoutFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_main"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/checkout_btn_proceed"
        android:padding="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_title"
                        android:textColor="@color/highlight_yellow_color"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/checkout_subtitle_description"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shipping_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/checkout_shipping_details_title"
                            android:textColor="@color/highlight_yellow_color"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/shipping_layout_btn"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/arrow_up_24px"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:tint="@color/highlight_yellow_color"
                            tools:ignore="ContentDescription" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ripple_soft" />

                    <LinearLayout
                        android:id="@+id/shipping_layout_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/first_name"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />

                                <EditText
                                    android:id="@+id/shipping_details_firstname"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/custom_input_search"
                                    android:hint="Dracula"
                                    android:inputType="textPersonName"
                                    android:autofillHints="personFirstName"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText,TouchTargetSizeCheck,TextContrastCheck" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/last_name"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />

                                <EditText
                                    android:id="@+id/shipping_details_lastname"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/custom_input_search"
                                    android:hint="VanHelsing"
                                    android:inputType="textPersonName"
                                    android:autofillHints="personLastName"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText,TouchTargetSizeCheck,TextContrastCheck" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/email_title"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp"
                            tools:ignore="TextContrastCheck" />

                        <EditText
                            android:id="@+id/shipping_details_email"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/custom_input_search"
                            android:hint="dracula@gmail.com"
                            android:inputType="textEmailAddress"
                            android:autofillHints="emailAddress"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText,TouchTargetSizeCheck,TextContrastCheck" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/contact_number"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp"
                            tools:ignore="TextContrastCheck" />

                        <EditText
                            android:id="@+id/shipping_details_contact"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/custom_input_search"
                            android:hint="+94 77 123 4567"
                            android:inputType="phone"
                            android:autofillHints="phone"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText,TouchTargetSizeCheck,TextContrastCheck" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/address_line_1"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp"
                            tools:ignore="TextContrastCheck" />

                        <EditText
                            android:id="@+id/shipping_details_address1"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:autofillHints="postalAddressStreetAddress"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/address_line_1"
                            android:inputType="textPostalAddress"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText,TouchTargetSizeCheck,TextContrastCheck,DuplicateSpeakableTextCheck,VisualLintTextFieldSize" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/address_line_2"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp"
                            tools:ignore="TextContrastCheck" />

                        <EditText
                            android:id="@+id/shipping_details_address2"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:autofillHints="postalAddressExtendedAddress"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/address_line_2"
                            android:inputType="textPostalAddress"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:ignore="TouchTargetSizeCheck,TextContrastCheck,DuplicateSpeakableTextCheck" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/city_text"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />

                                <EditText
                                    android:id="@+id/shipping_details_city"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/custom_input_search"
                                    android:hint="Colombo"
                                    android:inputType="text"
                                    android:autofillHints="postalAddressLocality"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText,TouchTargetSizeCheck,TextContrastCheck" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/postal_code_text"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />

                                <EditText
                                    android:id="@+id/shipping_details_postcode"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/custom_input_search"
                                    android:hint="12345"
                                    android:inputType="textPostalAddress"
                                    android:autofillHints="postalCode"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText,TouchTargetSizeCheck,TextContrastCheck" />

                            </LinearLayout>

                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/shipping_details_check_billing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:checked="true"
                            android:text="@string/billing_address_checkbox_text"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            tools:ignore="VisualLintButtonSize" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/billing_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/billing_details_title"
                            android:textColor="@color/highlight_yellow_color"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/billing_layout_btn"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/arrow_down_24px"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:tint="@color/highlight_yellow_color"
                            tools:ignore="ContentDescription" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ripple_soft" />

                    <LinearLayout
                        android:id="@+id/billing_layout_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/first_name"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp" />

                                <EditText
                                    android:id="@+id/billing_details_firstname"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/custom_input_search"
                                    android:hint="Dracula"
                                    android:inputType="textPersonName"
                                    android:autofillHints="personFirstName"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textSize="14sp"
                                    android:textColor="@android:color/white"
                                    tools:ignore="HardcodedText" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/last_name"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp" />

                                <EditText
                                    android:id="@+id/billing_details_lastname"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/custom_input_search"
                                    android:hint="VanHelsing"
                                    android:inputType="textPersonName"
                                    android:autofillHints="personLastName"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textSize="14sp"
                                    android:textColor="@android:color/white"
                                    tools:ignore="HardcodedText" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/email_title"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/billing_details_email"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/custom_input_search"
                            android:hint="dracula@gmail.com"
                            android:inputType="textEmailAddress"
                            android:autofillHints="emailAddress"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/contact_number"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/billing_details_contact"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/custom_input_search"
                            android:hint="+94 77 123 4567"
                            android:inputType="phone"
                            android:autofillHints="phone"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/address_line_1"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/billing_details_address1"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/address_line_1"
                            android:inputType="textPostalAddress"
                            android:autofillHints="postalAddressStreetAddress"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="14sp"
                            android:textColor="@android:color/white" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/address_line_2"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/billing_details_address2"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/address_line_2"
                            android:inputType="textPostalAddress"
                            android:autofillHints="postalAddressExtendedAddress"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="14sp"
                            android:textColor="@android:color/white" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/city_text"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp" />

                                <EditText
                                    android:id="@+id/billing_details_city"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/custom_input_search"
                                    android:hint="Colombo"
                                    android:inputType="text"
                                    android:autofillHints="postalAddressLocality"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textSize="14sp"
                                    android:textColor="@android:color/white"
                                    tools:ignore="HardcodedText" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/postal_code_text"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp" />

                                <EditText
                                    android:id="@+id/billing_details_postcode"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/custom_input_search"
                                    android:hint="12345"
                                    android:inputType="textPostalAddress"
                                    android:autofillHints="postalCode"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textSize="14sp"
                                    android:textColor="@android:color/white"
                                    tools:ignore="HardcodedText" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_order_summary"
                        android:textColor="@color/highlight_yellow_color"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Items will appear here"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/ripple_soft" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/checkout_subtotal"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/checkout_subtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs 0.00"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/delivery_fee"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/checkout_shipping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs 250.00"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/ripple_soft" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_text"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/checkout_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs 0.00"
                            android:textColor="@color/highlight_yellow_color"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_payment_method"
                        android:textColor="@color/highlight_yellow_color"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/payment_card_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="@color/card_background_light"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:contentDescription="@string/credit_card_text"
                                android:src="@drawable/credit_card_24px"
                                app:tint="@color/highlight_yellow_color" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="@string/checkout_payment_method_detail"
                                android:textColor="@android:color/white"
                                android:textSize="14sp" />

                            <RadioButton
                                android:id="@+id/radio_card"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:buttonTint="@color/highlight_yellow_color" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/checkout_btn_proceed"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="12dp"
        android:backgroundTint="@color/md_theme_onErrorContainer"
        android:text="@string/checkout_proceed_payment_text"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:icon="@drawable/arrow_forward_24px"
        app:iconGravity="textEnd"
        app:iconTint="@android:color/black"
        tools:ignore="TextContrastCheck,VisualLintButtonSize" />

</RelativeLayout>