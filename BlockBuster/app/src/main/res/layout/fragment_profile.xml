<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.ProfileFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_main"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profile_image"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:src="@drawable/contacts_product_24px"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="@color/app_primary_fixed"
                        app:strokeWidth="2dp"/>

                    <ImageView
                        android:id="@+id/profile_edit_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/circle_white_bg"
                        android:clickable="true"
                        android:contentDescription="@string/profile_edit_text"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:padding="6dp"
                        android:src="@drawable/edit_24px"
                        app:tint="@color/app_primary_fixed"
                        tools:ignore="DuplicateSpeakableTextCheck,TouchTargetSizeCheck" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_primary_fixed"/>

                    <ImageView
                        android:id="@+id/profile_edit_name"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:contentDescription="@string/profile_edit_text"
                        android:focusable="true"
                        android:padding="2dp"
                        android:src="@drawable/edit_24px"
                        app:tint="@color/app_primary_fixed"
                        tools:ignore="TouchTargetSizeCheck,ImageContrastCheck" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_fixed"/>

                </LinearLayout>



            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_account_information"
                            android:textStyle="bold"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="15sp"/>

                        <TextView
                            android:id="@+id/profile_save_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_save"
                            android:textColor="@color/app_primary_fixed"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp">

                        <LinearLayout
                            android:id="@+id/profile_firstname_display"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="@string/first_name"
                                android:textColor="@color/text_secondary_fixed"/>

                            <TextView
                                android:id="@+id/profile_firstname"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/profile_firstname_edit"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:autofillHints="givenName"
                            android:background="@drawable/custom_input_search"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="14sp"
                            android:inputType="textPersonName"
                            android:visibility="gone"
                            tools:ignore="LabelFor" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:id="@+id/profile_lastname_display"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="visible">

                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="@string/last_name"
                                android:textColor="@color/text_secondary_fixed"/>

                            <TextView
                                android:id="@+id/profile_lastname"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/profile_lastname_edit"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:autofillHints="familyName"
                            android:background="@drawable/custom_input_search"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="14sp"
                            android:visibility="gone"
                            android:inputType="textPersonName"
                            tools:ignore="LabelFor" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/profile_email_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="@string/email_title"
                            android:textColor="@color/text_secondary_fixed"/>

                        <TextView
                            android:id="@+id/profile_email_info"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_change_password_title"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/app_primary_fixed"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:endIconMode="password_toggle"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_current_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/profile_current_password_hint"
                            android:inputType="textPassword"
                            android:minHeight="44dp"
                            android:textSize="14sp"
                            tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:endIconMode="password_toggle"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_new_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/profile_new_password_hint"
                            android:inputType="textPassword"
                            android:minHeight="44dp"
                            android:textSize="14sp"
                            tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:endIconMode="password_toggle"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:background="@drawable/custom_input_search"
                            android:hint="@string/profile_confirm_new_password_hint"
                            android:inputType="textPassword"
                            android:minHeight="44dp"
                            android:textSize="14sp"
                            tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profile_update_password_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/profile_update_password"
                        android:textSize="14sp"
                        app:cornerRadius="8dp"
                        tools:ignore="VisualLintButtonSize" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_account_options"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/app_primary_fixed"/>

                    <TextView
                        android:id="@+id/profile_edit_profile_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_edit_profile"
                        android:drawablePadding="12dp"
                        android:layout_marginTop="14dp"
                        android:paddingVertical="6dp"
                        app:drawableStartCompat="@drawable/edit_24px"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"/>

                    <TextView
                        android:id="@+id/profile_change_password_option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_change_password_title"
                        android:drawablePadding="12dp"
                        android:layout_marginTop="6dp"
                        android:paddingVertical="6dp"
                        app:drawableStartCompat="@drawable/lock_24px"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:layout_marginVertical="10dp"/>

                    <TextView
                        android:id="@+id/profile_logout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/side_nav_logout_title"
                        android:textColor="@color/md_theme_onErrorContainer"
                        android:drawablePadding="12dp"
                        android:paddingVertical="6dp"
                        app:drawableStartCompat="@drawable/logout_24px"
                        app:drawableTint="@color/md_theme_onErrorContainer"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/profile_member_since"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_member_since"
                android:textSize="12sp"
                android:textColor="@color/text_secondary_fixed"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
