<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.SingleMovieFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_main"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/movieBanner"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:contentDescription="@string/movie_banner"
                android:scaleType="centerCrop"
                android:src="@drawable/movie_24px"
                tools:ignore="ImageContrastCheck" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="20dp"
                android:background="@color/dark_overlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/movieTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="The Fantastic Four: First Steps"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:id="@+id/btnFavorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        tools:ignore="TouchTargetSizeCheck">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/add_to_favorite"
                            android:src="@drawable/favorite_24px"
                            app:tint="@color/md_theme_onErrorContainer"
                            tools:ignore="ImageContrastCheck" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FAVORITE"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            tools:ignore="HardcodedText,SmallSp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnShare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        tools:ignore="TouchTargetSizeCheck">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/share"
                            android:src="@drawable/share_24px"
                            app:tint="@color/md_theme_onErrorContainer"
                            tools:ignore="ImageContrastCheck" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SHARE"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            tools:ignore="HardcodedText,SmallSp" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/movieYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="2025"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_rating_view"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:id="@+id/imdbRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7.5"
                            android:textColor="@color/rating_gold"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="2dp"
                            android:src="@drawable/imdb"
                            android:contentDescription="@null"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_rating_view"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:id="@+id/rtRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="86"
                            android:textColor="@color/md_theme_onErrorContainer"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="2dp"
                            android:src="@drawable/rt"
                            android:contentDescription="@null"/>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWatchTrailer"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/watch_trailer"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        app:backgroundTint="@color/md_theme_onErrorContainer"
                        app:icon="@drawable/play_arrow_24px"
                        app:iconGravity="textStart"
                        app:iconTint="@android:color/white"
                        app:strokeColor="@android:color/white"
                        app:strokeWidth="1dp"
                        tools:ignore="TouchTargetSizeCheck,VisualLintButtonSize" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuyDvd"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/highlight_yellow_color"
                        android:text="@string/buy_dvd_s"
                        android:textColor="@android:color/black"
                        android:textSize="13sp"
                        app:icon="@drawable/movie_24px"
                        app:iconGravity="textStart"
                        app:iconTint="@android:color/black"
                        tools:ignore="TouchTargetSizeCheck,VisualLintButtonSize" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:id="@+id/tabOverview"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="6dp"
                        tools:ignore="TouchTargetSizeCheck">

                        <TextView
                            android:id="@+id/tabOverviewTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/overview"
                            android:textColor="@color/highlight_yellow_color"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/indicatorOverview"
                            android:layout_width="24dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/highlight_yellow_color" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabCast"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        tools:ignore="TouchTargetSizeCheck">

                        <TextView
                            android:id="@+id/tabCastTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cast_crew_title"
                            android:textColor="@android:color/white" />

                        <View
                            android:id="@+id/indicatorCast"
                            android:layout_width="24dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/highlight_yellow_color"
                            android:visibility="gone" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabRelated"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tabRelatedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/related_movies_title"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />

                        <View
                            android:id="@+id/indicatorRelated"
                            android:layout_width="24dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/highlight_yellow_color"
                            android:visibility="invisible"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabBuyDvd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        tools:ignore="TouchTargetSizeCheck">

                        <TextView
                            android:id="@+id/tabBuyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/buy_dvd_s_title"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />

                        <View
                            android:id="@+id/indicatorBuy"
                            android:layout_width="24dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/highlight_yellow_color"
                            android:visibility="invisible" />

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/ripple_soft" />

                <FrameLayout
                    android:id="@+id/movieTabContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" />

                <LinearLayout
                    android:id="@+id/overviewContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/movieOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mister Fantastic, Invisible Woman, Human Torch and the Thing face their most daunting challenge yet as they defend Earth from Galactus and Silver Surfer."
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        tools:ignore="HardcodedText,VisualLintLongText" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_director_overview_title"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />

                                <TextView
                                    android:id="@+id/movieDirector"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Matt Shulman"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_stars_overview_title"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />

                                <TextView
                                    android:id="@+id/movieStars"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Robert Downey Jr., Pedro Pascal, Vanessa Kirby, Joseph Quinn, Julia Garner"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    android:maxLines="3"
                                    android:ellipsize="end"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_genres_overview_title"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />

                                <TextView
                                    android:id="@+id/movieGenres"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Action, Adventure, Comedy, Fantasy, Superhero"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_release_year_overview_title"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp"
                                    tools:ignore="TextContrastCheck" />

                                <TextView
                                    android:id="@+id/movieReleaseYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="2025"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_runtime_overview_title"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/movieRuntime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="115 min"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_mpaa_rating_overview_title"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/movieMpaaRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="PG-13"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_plot_keyword_overview_title"
                                    android:textColor="@color/app_primary_fixed"
                                    android:textSize="12sp" />

                                <com.google.android.flexbox.FlexboxLayout
                                    android:id="@+id/keywordsContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:flexWrap="wrap"
                                    app:flexDirection="row">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="superhero"
                                        android:textColor="@color/highlight_yellow_color"
                                        android:textSize="12sp"
                                        android:background="@drawable/keyword_bg"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="4dp"
                                        android:layout_marginEnd="8dp"
                                        tools:ignore="HardcodedText" />

                                </com.google.android.flexbox.FlexboxLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/castContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/single_movie_cast_overview_cast_crew_of"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/castMovieTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="The Fantastic Four: First Steps"
                        android:textColor="@color/app_primary_fixed"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/single_movie_cast_overview_director_text"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/directorRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ripple_soft"
                        android:layout_marginVertical="20dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/single_movie_cast_overview_cast_text"
                        android:textColor="@color/app_primary_fixed"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/castRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/relatedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/relatedRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/buyDvdContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/card_background_dark">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/single_movie_dvd_price"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/dvdPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rs 5000"
                                    android:textColor="@color/highlight_yellow_color"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/single_movie_availability"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/dvdStockStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_in_stock"
                                    android:textColor="@color/green_500"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/single_movie_available_qty"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/dvdStockCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/ripple_soft"
                                android:layout_marginVertical="16dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/single_movie_quantity"
                                    android:textColor="@android:color/white"
                                    android:textSize="14sp"
                                    android:layout_marginEnd="16dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center"
                                    android:background="@drawable/quantity_selector_bg">

                                    <ImageView
                                        android:id="@+id/btnDecreaseQty"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/minus_24px"
                                        android:padding="10dp"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="@string/single_movie_decrease_qty" />

                                    <TextView
                                        android:id="@+id/tvQuantity"
                                        android:layout_width="40dp"
                                        android:layout_height="wrap_content"
                                        android:text="1"
                                        android:textAlignment="center"
                                        android:textColor="@android:color/white"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        tools:ignore="HardcodedText" />

                                    <ImageView
                                        android:id="@+id/btnIncreaseQty"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/add_24px"
                                        android:padding="10dp"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:contentDescription="@string/single_movie_increase_quantity" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvMaxStockWarning"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:text=""
                                    android:textColor="@color/md_theme_onErrorContainer"
                                    android:textSize="11sp"
                                    android:visibility="gone" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="16dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/single_movie_total"
                                    android:textColor="@android:color/white"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvTotalPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rs 5000"
                                    android:textColor="@color/highlight_yellow_color"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:ignore="HardcodedText" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_marginTop="8dp"
                                android:baselineAligned="false">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAddToCart"
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:text="@string/single_movie_add_to_cart"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/white"
                                    app:icon="@drawable/shopping_cart_24px"
                                    app:iconGravity="textStart"
                                    app:iconTint="@android:color/white"
                                    android:backgroundTint="@color/md_theme_onErrorContainer"
                                    app:cornerRadius="12dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBuyNow"
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/single_movie_buy_now"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/black"
                                    app:icon="@drawable/bolt_24px"
                                    app:iconGravity="textStart"
                                    app:iconTint="@android:color/black"
                                    android:backgroundTint="@color/highlight_yellow_color"
                                    app:cornerRadius="12dp" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>