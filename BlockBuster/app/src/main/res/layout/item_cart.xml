<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/card_background_dark"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/item_cart_image"
            android:layout_width="80dp"
            android:layout_height="100dp"
            android:background="@drawable/square_image_bg"
            android:contentDescription="@string/movie_banner"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/movie_24px"
            tools:ignore="ImageContrastCheck" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_cart_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Fantastic Four: First Steps"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="2"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/item_cart_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rs 5000.00"
                android:textColor="@color/highlight_yellow_color"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/item_cart_remove"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/remove_item"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/delete_fill_24px"
                app:tint="@color/md_theme_onErrorContainer"
                tools:ignore="TouchTargetSizeCheck,ImageContrastCheck" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/quantity_selector_bg"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/item_cart_btn_plus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/increase_quantity"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/add_24px"
                app:tint="@android:color/white"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/item_cart_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textAlignment="center"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingVertical="6dp"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/item_cart_btn_minus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/decrease_quantity"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/minus_24px"
                app:tint="@android:color/white"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>