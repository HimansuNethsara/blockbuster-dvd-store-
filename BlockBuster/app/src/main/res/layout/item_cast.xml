<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp">

    <ImageView
        android:id="@+id/castImageView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/contacts_product_24px"
        android:scaleType="centerCrop"
        android:contentDescription="@string/single_movie_cast_overview_cast_image"
        android:background="@drawable/square_image_bg"
        android:padding="4dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/castNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cast Name"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText,TextContrastCheck" />

    </LinearLayout>

</LinearLayout>