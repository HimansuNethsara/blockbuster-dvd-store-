<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardPreventCornerOverlap="true"
    app:rippleColor="?attr/colorControlHighlight"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="90dp"
            android:elevation="2dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/suggestion_product_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/movie_24px"
                android:contentDescription="@string/movie_banner"
                app:strokeColor="?attr/colorPrimaryContainer"
                app:strokeWidth="1dp" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/suggestion_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="The Fantastic Four: First Steps" />

            <TextView
                android:id="@+id/suggestion_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/app_primary_fixed"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                tools:text="Rs 5,000.00" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/suggestion_quick_action"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/single_movie_add_to_cart"
            app:icon="@drawable/shopping_cart_24px"
            app:iconTint="@color/app_primary_fixed"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>