    <!-- Terms of Service -->
    <string name="terms_service_title">Terms of Service</string>
    <string name="terms_service_text_main">Welcome to BlockBuster. By creating an account and using this application, you agree to the following terms and conditions.</string>
    <string name="terms_service_sub_title1">User Responsibilities</string>
    <string name="terms_service_sub_title2">Application Usage</string>
    <string name="terms_service_sub_title1_line1">Use BlockBuster to browse, discover and track movies.</string>
    <string name="terms_service_sub_title1_line2">Keep your account credentials secure and accurate.</string>
    <string name="terms_service_sub_title1_line3">Do not misuse the app or attempt to disrupt its services.</string>
    <string name="terms_service_sub_title2_line1">BlockBuster may update features, content, or policies periodically.</string>
    <string name="terms_service_sub_title2_line2">Continued use of the application indicates acceptance of updated terms.</string>
    <string name="terms_service_text_close">BlockBuster is committed to providing a safe and enjoyable movie discovery experience for all users.</string>
    <string name="close_text">Close</string>

    <!-- Privacy Policy -->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_text_main">BlockBuster respects your privacy and is committed to protecting your personal information.This policy explains what data we collect and how it is used within the application.</string>
    <string name="privacy_policy_subtitle1">Information We Collect</string>
    <string name="privacy_policy_subtitle1_line1">Your name and email address when creating an account.</string>
    <string name="privacy_policy_subtitle1_line2">Your movie preferences and watch history to improve recommendations.</string>
    <string name="privacy_policy_subtitle1_line3">Anonymous usage analytics to enhance app performance and features.</string>
    <string name="privacy_policy_subtitle2">How Your Data Is Used</string>
    <string name="privacy_policy_subtitle2_line1">Your information helps personalize your BlockBuster experience and movie suggestions.</string>
    <string name="privacy_policy_subtitle2_line2">Your personal data will never be sold or shared with third parties without your consent.</string>
    <string name="privacy_policy_text_close">BlockBuster values transparency and security. By using the application, you acknowledge and agree to this privacy policy.</string>

